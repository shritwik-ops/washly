# Local Supabase dev instance. Get current values with `supabase status`
# (run from /supabase). ANON_KEY is a fixed local-dev default, safe to share.
#
# Note: 127.0.0.1 works from the iOS Simulator and web, but NOT from the
# Android emulator -- use 10.0.2.2 instead of 127.0.0.1 there. A physical
# device needs your machine's LAN IP.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
